    "timeline": {
      "eyebrow": "Our Journey",
      "headingLine1": "16 Years of",
      "headingHighlight": "Engineering Growth",
      "intro": "From a single-division startup to a multi-division EPC powerhouse — here's how BTEL grew.",
      "milestones": [
        {
          "year": "2004",
          "title": "Bangla Trac Group Founded",
          "description": "Parent conglomerate Bangla Trac Group established, laying the foundation for BTEL's future engineering operations.",
