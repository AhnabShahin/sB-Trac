# Normalize all text files to LF in the repo and working tree.
# eol=lf stops core.autocrlf from churning line endings on Windows.
* text=auto eol=lf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.mp4 binary
*.webm binary
*.db binary
*.sqlite binary
